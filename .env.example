# Copy to .env and fill in what you need. Every variable is optional in development.

# --- Server -------------------------------------------------------------
# PORT=3000
# HOST=::
# Builder origin (used for CSRF checks and preview postMessage). Dev: Vite on 5173.
# APP_URL=http://localhost:5173
# Previews live at pv-<token>.<SANDBOX_DOMAIN>, published apps at <slug>.<SANDBOX_DOMAIN>.
# In production use a separate domain with a wildcard DNS record, e.g. SANDBOX_DOMAIN=yasa-apps.com
# SANDBOX_DOMAIN=localhost:3000
# SANDBOX_PROTOCOL=http
# DATA_DIR=./data
# APP_SECRET=change-me-to-a-long-random-string
# TRUST_PROXY=false
# SIGNUPS_ENABLED=true

# --- AI providers (at least one, or use Demo mode) -----------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_EFFORT=high
# GEMINI_API_KEY=...
# NVIDIA NIM (build.nvidia.com). With several providers configured, a turn moves to the next one automatically
# when the requested model is out of quota, overloaded or unreachable.
# NVIDIA_API_KEY=nvapi-...
# OpenRouter (openrouter.ai): one key for many models. Models whose id ends in ":free" work without credits and
# become the default when no Anthropic key is set (see "Bepul OpenRouter modellari" in README.md).
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5
# DEFAULT_MODEL=anthropic:claude-opus-5
# ENABLE_MOCK_PROVIDER=true

# --- Limits --------------------------------------------------------------
# Messages per user per UTC day when using the server's API keys (0 = unlimited).
# DAILY_MESSAGE_LIMIT=100

# --- Accounts (optional: Clerk) -------------------------------------------
# With both keys set, Clerk handles sign-up and sign-in (email, Google, ...). Without them the built-in
# email + password accounts are used. `clerk env pull` writes them to .env.local for you.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# --- AI images ---------------------------------------------------------------
# Who draws the pictures the AI asks for: auto (default) tries Gemini's image model when the key has image
# quota, then FLUX on NVIDIA NIM (works with the free NIM key), then a slow keyless public service.
# IMAGE_PROVIDER=auto        # auto | gemini | nvidia | pollinations | off

# --- Capacity ----------------------------------------------------------------
# Generations that may run at the same time on this server, and per user.
# MAX_CONCURRENT_GENERATIONS=32
# MAX_GENERATIONS_PER_USER=2
