# Copy to deploy/.env and fill in. This file is read by docker compose; never commit the filled-in copy.

# --- Domains ---------------------------------------------------------------
# Where people open the builder.
APP_DOMAIN=yasa.example.com
# A SEPARATE registered domain for previews and published apps (not a subdomain of APP_DOMAIN), so that
# user-made apps never share cookies with the builder. DNS: A records for "@" and "*" → this server.
SANDBOX_DOMAIN=yasa-apps.example.com
# Contact address for Let's Encrypt.
ACME_EMAIL=you@example.com
# Cloudflare API token with "Zone → DNS → Edit" for SANDBOX_DOMAIN (used for its wildcard certificate).
CLOUDFLARE_API_TOKEN=

# --- Secrets ---------------------------------------------------------------
# Encrypts stored API keys and tokens. Generate once: openssl rand -base64 48
APP_SECRET=

# --- Accounts (Clerk production instance) -----------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# --- AI providers (at least one) -------------------------------------------
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Messages per user per day on the server's own keys (0 = unlimited).
DAILY_MESSAGE_LIMIT=100
